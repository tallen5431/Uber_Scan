        "fallback": 25,
        "expect": 25.0
      },
      {
        "name": "letters",
        "in": "abc",
        "fallback": 25,
        "expect": 25.0
      },
      {
        "name": "nothing",
        "in": null,
        "fallback": 25,
        "expect": 25.0
      },
      {
        "name": "a boolean",
        "in": true,
        "fallback": 25,
        "expect": 25.0
      },
      {
        "name": "a list",
        "in": [],
        "fallback": 25,
        "expect": 25.0
      },
      {
        "name": "zero",
        "in": 0,
        "fallback": 25,
        "expect": 0.0
      },
      {
        "name": "a negative",
        "in": -5,
        "fallback": 25,
        "expect": -5.0
      },
      {
        "name": "not a number",
        "in": "@nan",
        "fallback": 25,
        "expect": 25.0
      },
      {
        "name": "infinity",
