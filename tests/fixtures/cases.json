      "settings": {
        "target": 25,
        "costPerMile": 0
      },
      "expect": {
        "perHour": 12.51,
        "state": "no",
        "grossPerHour": 12.51
      }
    },
    {
      "name": "the real offer, less mileage cost",
      "text": "$7.09 6 items (6 units) 34 min (3.6 mi) total",
      "settings": {
        "target": 25,
