  "_coerce_comment": "The three functions that decide what an offer is judged against, checked in both languages from one list. Every one of these had drifted: Number('  ') is 0 in JavaScript so a whitespace target meant every offer was an ACCEPT while Python fell back to 25; float() takes '1e3' and '1_0' and parseFloat does not; and Infinity and NaN were guarded out of doubt() in JavaScript and compared against the bounds in Python. None of it was reachable from a test. '@inf', '@-inf' and '@nan' stand in for values JSON cannot hold.",
  "coerce": {
    "toNumber": [
      {
        "name": "a plain figure",
        "in": "25",
        "expect": 25.0
      },
      {
        "name": "a decimal",
        "in": "1.5",
        "expect": 1.5
      },
      {
        "name": "a comma read for a point",
        "in": "1,5",
        "expect": 1.5
      },
      {
        "name": "a leading point",
        "in": ".5",
        "expect": 0.5
      },
      {
        "name": "a signed figure",
        "in": "-3",
        "expect": -3.0
      },
      {
        "name": "surrounding space",
        "in": " 25 ",
        "expect": 25.0
      },
      {
        "name": "scientific notation",
        "in": "1e3",
        "expect": null
      },
      {
        "name": "a digit separator",
        "in": "1_0",
        "expect": null
      },
      {
        "name": "the word nan",
        "in": "nan",
        "expect": null
      },
      {
        "name": "the word Infinity",
        "in": "Infinity",
        "expect": null
      },
      {
        "name": "letters",
        "in": "abc",
        "expect": null
      },
      {
        "name": "nothing at all",
        "in": "",
        "expect": null
      },
      {
        "name": "only space",
        "in": "   ",
        "expect": null
      },
      {
        "name": "two points",
        "in": "1.2.3",
        "expect": null
      },
      {
        "name": "a trailing point",
        "in": "12.",
        "expect": 12.0
      }
    ],
    "setting": [
      {
        "name": "a number",
        "in": 30,
        "fallback": 25,
        "expect": 30.0
      },
      {
        "name": "a numeric string",
        "in": "30",
        "fallback": 25,
        "expect": 30.0
      },
      {
        "name": "an empty string",
        "in": "",
        "fallback": 25,
        "expect": 25.0
      },
      {
