      },
      "expect": {
        "perHour": 10.61,
        "state": "no",
        "grossPerHour": 12.51
      }
    },
    {
      "name": "the real offer, with 90s per item of shopping",
      "text": "$7.09 6 items (6 units) 34 min (3.6 mi) total",
      "settings": {
        "target": 25,
        "costPerMile": 0.3,
        "secondsPerItem": 90
