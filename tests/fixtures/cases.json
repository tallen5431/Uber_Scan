    {
      "name": "a 56 mph highway run is charged for its miles, not excused them",
      "text": "$52.00 2 hr 5 min (115.0 mi) total",
      "settings": {
        "target": 25,
        "costPerMile": 0.3
      },
      "expect": {
        "perHour": 8.4,
        "cost": 34.5,
        "state": "no"
