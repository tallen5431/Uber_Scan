# Every ten minutes, and once shortly after boot.
#
# The interval is not a throughput decision — a shift's offers are about 50KB —
# it is how long the newest offer can be missing from the copy if the SD card
# dies at the worst moment. Ten minutes of exposure for one request that is
# usually a few hundred bytes and often nothing at all.
#
# Persistent=true so a run missed while the car was parked and the Pi powered
# down happens once at the next boot rather than being skipped silently.
[Unit]
Description=Copy this rig's offers to the machine that keeps them, regularly

[Timer]
OnBootSec=2min
OnUnitActiveSec=10min
Persistent=true
# Spread the load if several rigs ever point at one machine, and stop every Pi
# on earth hitting it on the same minute.
RandomizedDelaySec=60s

[Install]
WantedBy=timers.target
